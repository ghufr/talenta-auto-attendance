{
	"name": "talenta-auto-attendance",
	"version": "1.0.0",
	"description": "Automate your Talenta attendance with Cloudflare Worker script that simulates check-in and check-out processes using scheduled cron jobs",
	"main": "src/worker.ts",
	"scripts": {
		"deploy": "npx wrangler deploy --env prod",
		"start:dev": "npx wrangler dev --test-scheduled --remote",
		"test": "jest",
		"generate-types": "npx wrangler types",
		"lint": "eslint . --ext .js,.ts"
	},
	"keywords": [
		"talenta",
		"script",
		"attendance",
		"cloudflare",
		"automation",
		"cron",
		"worker"
	],
	"author": {
		"name": "Ghufron",
		"email": "ghufronfr@gmail.com",
		"url": "https://github.com/ghufr"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ghufr/talenta-auto-attendance.git"
	},
	"bugs": {
		"url": "https://github.com/ghufr/talenta-auto-attendance/issues"
	},
	"homepage": "https://github.com/ghufr/talenta-auto-attendance#readme",
	"type": "module",
	"license": "GPL-3.0",
	"devDependencies": {
		"@babel/core": "^7.26.10",
		"@babel/preset-env": "^7.26.9",
		"@types/jest": "^29.5.14",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.29.0",
		"eslint": "^9.24.0",
		"eslint-plugin-jest": "^28.11.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.2"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"dependencies": {
		"@types/node": "^22.14.0",
		"axios": "^1.8.4",
		"zod": "^3.24.2"
	}
